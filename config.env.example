# WindRAG 环境配置
# 复制本文件为 config.env 并按需修改（config.env 已在 .gitignore 中，不会提交）
#
# 主线走标准库 urllib 直连 OpenAI 兼容接口，不需要 SDK（不要 pip install zhipuai）。

# ===== LLM（通用键，优先于 MODELSCOPE_*）=====
# 供应商：zhipu | modelscope，决定默认服务地址与默认模型池
#   zhipu      https://open.bigmodel.cn/api/paas/v4
#   modelscope https://api-inference.modelscope.cn/v1
LLM_PROVIDER=zhipu
LLM_API_KEY=your_api_key_here

# 模型列表，逗号分隔，格式：name:priority（priority 越小优先级越高，失败自动切下一个并冷却 60s）
# 轮流使用：一次调用成功后引擎会自动换到下一个模型，也会把轮转位存在 data/pure_index/llm_rotation.json，
# 这样命令行一次一个新进程时也不会总用同一个模型。只填免费档，否则会把余额用掉。
#   关推理后的实测延迟：glm-4-flash-250414（约 2.4s）/ glm-4.7-flash（约 4.0s，偶发 429/1305 过载）
#   glm-4v-flash（多模态，约 5.9s）/ glm-4-flash（约 6.1s）/ glm-4.5-flash（约 27s）
#   4.5 与 4.7 会自动带 thinking.type=disabled，不关的话推理写满 token、留不下正文
#   不入池：glm-z1-flash（关不住推理，实测被 token 截断）、glm-4.6-flash（403/1220 无权限）、
#           glm-5.x 与 glm-4-air/airx/long/plus（收费档，429/1113 余额不足）
LLM_MODELS=glm-4-flash-250414:1,glm-4.7-flash:2,glm-4v-flash:3,glm-4-flash:4,glm-4.5-flash:5

# 显式指定服务地址时填这里，优先级高于 LLM_PROVIDER 的默认值（留空即可）
LLM_BASE_URL=

# ===== 开关 =====
# 设为 true 可强制禁用 LLM，只用「检索 + 抽取式生成」（适合无网络 / 无 key 环境）
DISABLE_LLM=false

# ===== 遗留 ModelScope 配置（LLM_* 未配置时才会用到）=====
MODELSCOPE_API_KEY=
MODELSCOPE_MODELS=Qwen/Qwen2.5-7B-Instruct:1,Qwen/Qwen2.5-72B-Instruct:2
