# WindRAG 环境配置
# 复制本文件为 config.env 并按需修改（config.env 已在 .gitignore 中，不会提交）

# ===== LLM（ModelScope 云端 API，可选）=====
# 留空或不配置时，系统自动降级为「检索 + 模板生成」，无需任何大模型即可运行
MODELSCOPE_API_KEY=
# 模型列表，逗号分隔，格式：name:priority（priority 越小优先级越高）
MODELSCOPE_MODELS=Qwen/Qwen2.5-7B-Instruct:1,Qwen/Qwen2.5-72B-Instruct:2

# ===== 开关 =====
# 设为 true 可强制禁用 LLM，仅使用「检索 + 模板」（适合无网络 / 无 key 环境）
DISABLE_LLM=false
