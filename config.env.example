# WindRAG 环境配置
# 复制本文件为 config.env 并按需修改（config.env 已在 .gitignore 中，不会提交）
#
# 主线走标准库 urllib 直连 OpenAI 兼容接口，不需要 SDK（不要 pip install zhipuai）。

# ===== LLM（通用键，优先于 MODELSCOPE_*）=====
# 供应商：zhipu | modelscope，决定默认服务地址与默认模型池
#   zhipu      https://open.bigmodel.cn/api/paas/v4
#   modelscope https://api-inference.modelscope.cn/v1
LLM_PROVIDER=zhipu
LLM_API_KEY=your_api_key_here

# 模型列表，逗号分隔，格式：name:priority（priority 越小优先级越高，失败自动切下一个）
# 只填账户里免费可调的档，别把收费档放进池子，否则会消耗余额：
#   实测可用且出正文正常：glm-4-flash-250414（约 4.3s）/ glm-4-flash（约 9.0s）/ glm-4.5-flash（约 54s）
#   glm-z1-flash 免费但把思维链写进 content，max_tokens 用完就没答案，默认不入池
#   glm-4v-flash 为多模态免费档；glm-4.7-flash 免费但常返 429/1305「当前访问量过大」
#   glm-4.6-flash 返 403/1220 无权访问；glm-5.x、glm-4-air/airx/long/plus 属收费档（429/1113 余额不足）
LLM_MODELS=glm-4-flash-250414:1,glm-4-flash:2,glm-4.5-flash:3

# 显式指定服务地址时填这里，优先级高于 LLM_PROVIDER 的默认值（留空即可）
LLM_BASE_URL=

# ===== 开关 =====
# 设为 true 可强制禁用 LLM，只用「检索 + 抽取式生成」（适合无网络 / 无 key 环境）
DISABLE_LLM=false

# ===== 遗留 ModelScope 配置（LLM_* 未配置时才会用到）=====
MODELSCOPE_API_KEY=
MODELSCOPE_MODELS=Qwen/Qwen2.5-7B-Instruct:1,Qwen/Qwen2.5-72B-Instruct:2
